      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_1044046482956288]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_1044046483517441]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 then &quot;Luxury&quot;&#13;&#10;ELSEIF [Price] &gt;=150 THEN &quot;Standared&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_1044046484267010]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;Less Reiviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_1044046484860931]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;=TODAY() THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_1044046488498183]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 1044046488289286] THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Host_Since' datatype='date' name='[Calculation_1044046495911944]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since (AirBnB!NYC)],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Review Score Rating (bin)1' datatype='string' name='[Calculation_1044046497570826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating (AirBnB!NYC)]),&quot;Not Reated&quot;)' />
      </column>
      <column caption='Review Score Rating (bin)' datatype='real' name='[Calculation_1044046499844108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Review Scores Rating],90.74)' />
      </column>
