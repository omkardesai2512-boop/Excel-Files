      <aliases enabled='yes' />
      <column caption='Average bed count' datatype='real' name='[Calculation_1067134464733185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='avg([Beds])' />
      </column>
      <column caption='Average review score' datatype='real' name='[Calculation_1067134465286146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Review Scores Rating])' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_1067134467682307]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; 4000 then &quot;Low price&quot; ELSE &quot;High Price&quot; END' />
      </column>
      <column caption='Total Price' datatype='integer' name='[Calculation_1067134468366340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Price])' />
      </column>
      <column caption='Mid' datatype='string' name='[Calculation_1067134471163911]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MID([Neighbourhood],1,4)' />
      </column>
      <column caption='Concat' datatype='string' name='[Calculation_1067134471933960]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Neighbourhood] +&quot; &quot;+ [Neighbourhood]' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_1067134475005962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1067134464733185]+ SUM(INT([Zipcode]))' />
      </column>
      <column caption='DateDiff' datatype='integer' name='[Calculation_1067134476173323]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, MAKEDATE(2020,01,12), MAKEDATE(2020,01,30))' />
      </column>
